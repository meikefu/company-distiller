{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "不可变的公司对象 Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject_id", "predicate", "value", "claim_type", "scope", "valid_from", "valid_to", "observed_at", "evidence_ids", "decision", "confidence", "supersedes", "contradicts", "policy_id", "created_by_run"],
  "properties": {
    "id": {"type": "string"},
    "subject_id": {"type": "string"},
    "predicate": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]+$"},
    "value": {},
    "claim_type": {"enum": ["fact", "metric", "statement", "observation", "inference", "hypothesis", "risk", "obligation", "unknown"]},
    "scope": {"enum": ["company", "commercial_relationship", "product_use_service"]},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "decision": {"enum": ["proposed", "accepted", "rejected", "retracted"]},
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_reliability", "corroboration", "inference_strength", "overall"],
      "properties": {
        "source_reliability": {"enum": ["low", "medium", "high"]},
        "corroboration": {"enum": ["none", "single", "multiple"]},
        "inference_strength": {"enum": ["direct", "derived", "speculative"]},
        "overall": {"enum": ["low", "medium", "high"]}
      }
    },
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "contradicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "policy_id": {"type": "string"},
    "created_by_run": {"type": "string"}
  }
}
