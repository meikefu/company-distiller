{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "可寻址的证据单元",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "evidence_type", "source_ids", "record_ids", "event_ids", "locator", "excerpt", "observed_at", "policy_id", "created_by_run"],
  "properties": {
    "id": {"type": "string"},
    "evidence_type": {"enum": ["document_excerpt", "structured_observation", "interview_statement", "contract_term", "ticket_observation", "usage_aggregate"]},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "record_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "event_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "locator": {"type": "string", "minLength": 1},
    "excerpt": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "policy_id": {"type": "string"},
    "derived_from": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "created_by_run": {"type": "string"}
  }
}
