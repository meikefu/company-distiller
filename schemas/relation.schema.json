{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relation.schema.json",
  "title": "有证据支持的实体关系",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject_id", "predicate", "object_id", "valid_from", "valid_to", "observed_at", "evidence_ids", "confidence", "policy_id", "created_by_run"],
  "properties": {
    "id": {"type": "string"},
    "subject_id": {"type": "string"},
    "predicate": {"enum": ["owns", "contains", "employs", "has_role", "offers", "serves", "sells_to", "partners_with", "integrates_with", "depends_on", "supplies", "funded_by", "acquired", "competes_with", "substitutes_for", "regulated_by", "risks_from", "uses_channel", "targets_market", "party_to", "uses_product", "reports_to"]},
    "object_id": {"type": "string"},
    "context": {"type": ["string", "null"]},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "confidence": {"enum": ["low", "medium", "high"]},
    "policy_id": {"type": "string"},
    "created_by_run": {"type": "string"}
  }
}
